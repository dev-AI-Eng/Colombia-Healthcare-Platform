# Copy to .env for local development. .env is git-ignored; never commit it.
# In staging and production, supply these through the environment or SECRETS_DIR
# (see src/core/config.py). The application refuses to start there on placeholders.

APP_ENV=local
LOG_LEVEL=INFO

# Owner account: creates the database and runs migrations. main.py needs it to
# be allowed to create databases and roles (the default 'postgres' superuser is).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally

# Runtime account the API connects as. main.py creates it and sets this password.
APP_DB_USER=clinic_app
APP_DB_PASSWORD=change-me-locally-app

# Column encryption and blind-index keys: random values of at least 32 characters.
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing a key makes previously stored values unreadable (encryption key) or
# unfindable (blind-index key). Local placeholders below are for development only.
PHI_ENCRYPTION_KEY=local-dev-key-not-for-production-000000000
PHI_BLIND_INDEX_KEY=local-dev-bidx-not-for-production-00000000

# Keys the audit hash chain. Without it the chain could be recomputed end to end
# by anyone who can write to the database, so outside development it belongs in a
# store the database account cannot reach. Changing it invalidates existing
# entries, which then verify as broken from the first one.
AUDIT_CHAIN_KEY=local-dev-audit-chain-not-for-production

# How long conversation checkpoints are kept after a thread goes idle. They hold
# patient data; the sweep is run by 'python -m src.conversation.checkpointer'.
CHECKPOINT_RETENTION_DAYS=30

# Column mapping may ask a model about a column the dictionary and fuzzy matcher
# could not resolve. Both are optional: with neither set the importer still works
# and those columns go to the person confirming the import instead. Only column
# headings, counts and examples we generate are ever sent — never a cell value.
OPENAI_API_KEY=
GROQ_API_KEY=

# Real-data gate (ADR-11, ADR-15). Keep false until the compliance package is signed.
ALLOW_REAL_PATIENT_DATA=false

# Requests per client IP per minute, per API process.
RATE_LIMIT_PER_MINUTE=60
